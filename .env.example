# These are the only environment variables this app reads.
# Copy to .env.local for local work.

# ── Database ────────────────────────────────────────────────────────────────
# Neon connection string. Provisioned by the Vercel Marketplace integration —
# do not set it by hand:
#   vercel env pull .env.local --yes
#
# That pull also writes ~17 further keys (POSTGRES_*, PG*, DATABASE_URL_UNPOOLED,
# NEON_*, VERCEL_OIDC_TOKEN). They are Neon/Vercel aliases for other tooling;
# nothing in this codebase reads them, so they are not listed here.
DATABASE_URL=

# Set to 1 to run against a local PGlite database (.pglite) instead of Neon.
# `npm run dev:local` sets this for you. Strictly opt-in: there is no fallback,
# so a missing DATABASE_URL fails rather than silently writing locally.
USE_LOCAL_DB=

# ── Email notifications ─────────────────────────────────────────────────────
# Provisioned by the Resend Marketplace integration. If unset, RSVPs still save
# normally and the notification is simply skipped.
RESEND_API_KEY=

# Where the "someone replied" emails go. Defaults to vudoan1708@gmail.com.
NOTIFY_EMAIL=

# Sender address. Defaults to Resend's shared onboarding@resend.dev, which needs
# no domain verification but only delivers to the Resend account owner. Point it
# at an address on a verified domain to send anywhere.
RESEND_FROM=

# ── Host dashboard ──────────────────────────────────────────────────────────
# Password for /host. Required — sign-in is refused without it. Not provisioned
# by Vercel; set it per environment with `vercel env add HOST_PASSWORD`.
HOST_PASSWORD=change-me

# Optional. Signs the host session cookie. Falls back to HOST_PASSWORD if unset,
# which means changing the password also invalidates existing sessions.
HOST_SESSION_SECRET=
